{
  "name": "laya-delivery-robot-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n laya,web -c magenta,cyan \"pnpm --filter laya-service start\" \"pnpm dev:web\"",
    "dev:web": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "dev:laya": "pnpm --filter laya-service start",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "concurrently -k -n laya,web \"pnpm --filter laya-service start\" \"pnpm start:web\"",
    "start:web": "NEXT_TELEMETRY_DISABLED=1 next start",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter laya-service typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "fetch-models": "node scripts/fetch-models.mjs",
    "bench:laya": "node scripts/bench-laya.mjs",
    "quant:eval": "pnpm --filter laya-service quant-eval"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
