# Laya bundle directory (pnpm fetch-models puts it here). Relative paths resolve from the repo root.
LAYA_MODEL_DIR=./models/laya
# auto | dml | cuda | webgpu | cpu   (auto = GPU EP for this OS, then cpu)
LAYA_EP=auto
LAYA_INTRA_THREADS=8
# Decision base rate (Hz). Per-criterion rates live in shared/criteria/*; see docs/bench.md
DECISION_HZ=0.7
# Where Next.js proxies /api/laya/* to. Point at the Pi to let the rover brain decide:
#   LAYA_ENDPOINT=http://<pi-ip>:8787
LAYA_ENDPOINT=http://127.0.0.1:8787
LAYA_PORT=8787
# Host the service binds to (0.0.0.0 on the Pi so the PC dashboard can reach it)
LAYA_HOST=127.0.0.1
# Minimap tiles: off (default, no network) | osm
NEXT_PUBLIC_MAP_TILES=off
